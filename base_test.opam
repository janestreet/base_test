opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/janestreet/base_test"
bug-reports: "https://github.com/janestreet/base_test/issues"
dev-repo: "git+https://github.com/janestreet/base_test.git"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/base_test/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
run-test: [
  ["dune" "runtest" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.1.0"}
  "base"
  "base_quickcheck"
  "bignum"
  "core"
  "expect_test_helpers_base"
  "expectable"
  "portable"
  "ppx_jane"
  "ppx_loc"
  "sexp_grammar"
  "sexplib"
  "stdio"
  "unboxed"
  "dune"                     {>= "3.17.0"}
]
available: arch != "x86_32"
conflicts: [
  "oxcaml-compiler" {< "5.2.0minus39"}
]
synopsis: "Tests for Base"
description: "
Part of Jane Street's Core library
Tests for the Base library.
"
